# Copy this file to .env and fill in real values. Never commit .env.

# Backend (Spring Boot)
MAIL_USERNAME=your-address@gmail.com
# Gmail app password: https://myaccount.google.com/apppasswords
MAIL_PASSWORD=
DB_URL=jdbc:mysql://localhost:3306/farm_fresh?serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=
# Generate with: openssl rand -base64 64
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend (Vite)
VITE_API_URL=http://localhost:8080/api

# Production only (deploy/docker-compose.prod.yml, see docs/deployment.md)
# Domain pointing at your server; Caddy gets the HTTPS certificate for it
DOMAIN=
BACKUP_KEEP_DAYS=7
